# Aerial Arena environment configuration (copy to .env only if you need to override defaults)

# Match server
PORT=3001          # hosts like Render/Railway/Fly set PORT for you
HOST=0.0.0.0

# Player database. Set to a Postgres URL (e.g. Neon) to keep accounts across restarts;
# leave unset to use a local SQLite file in $DATA_DIR (default ./data). Never commit the real value.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Client -> server URL. Leave UNSET for normal use: the client auto-detects
#  - dev (Vite on :3000): ws://<same host>:3001
#  - deployed single service: same origin as the page (wss:// on https)
# Only set this if the client and match server live on different domains, e.g.:
# VITE_SERVER_URL=wss://arena-server.example.com
